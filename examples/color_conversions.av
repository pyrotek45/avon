// Color space conversion and analysis
// Demonstrates hex <-> RGB <-> HSL conversions and color analysis

let colors = {
  red: "#FF0000",
  green: "#00FF00", 
  blue: "#0000FF",
  cyan: "#00FFFF",
  magenta: "#FF00FF",
  yellow: "#FFFF00"
} in

let convert_color = \name \hex
  {
    name: name,
    hex: hex,
    rgb: hex_to_rgb hex,
    hsl: hex_to_hsl hex,
    inverted: invert_color hex,
    grayscale: grayscale hex
  } in

let converted = {
  red: convert_color "red" (get colors "red"),
  green: convert_color "green" (get colors "green"),
  blue: convert_color "blue" (get colors "blue"),
  cyan: convert_color "cyan" (get colors "cyan"),
  magenta: convert_color "magenta" (get colors "magenta"),
  yellow: convert_color "yellow" (get colors "yellow")
} in

@color_analysis.json {
  {
    "colors": converted,
    "conversions": {
      "red_to_rgb": hex_to_rgb "#FF0000",
      "rgb_to_hex": rgb_to_hex 255 0 0,
      "red_to_hsl": hex_to_hsl "#FF0000",
      "hsl_to_hex": hsl_to_hex 0 100 50
    }
  }
}
