// File system report generator using ricing functions
// Generates formatted reports of file sizes and permissions

let files = [
  {name: "main.rs", size: 45678, perms: 644},
  {name: "lib.rs", size: 23456, perms: 644},
  {name: "script.sh", size: 5432, perms: 755},
  {name: "data.json", size: 1048576, perms: 644},
  {name: "archive.tar.gz", size: 52428800, perms: 644},
  {name: "executable", size: 2097152, perms: 755}
] in

let format_file_info = \file
  {
    name: get file "name",
    size_bytes: get file "size",
    size_formatted: format_filesize (get file "size"),
    permissions_numeric: get file "perms",
    permissions_symbolic: chmod_symbolic (get file "perms")
  } in

let formatted_files = map format_file_info files in

let total_size = sum (map (\f get f "size") files) in

@file_report.json {
  {
    "timestamp": "generated",
    "files": formatted_files,
    "total_size_bytes": total_size,
    "total_size_formatted": format_filesize total_size,
    "file_count": length files
  }
}
