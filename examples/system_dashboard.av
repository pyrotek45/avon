# System dashboard with gauges and bars
# Displays system metrics using progressbar and gauge functions

let cpu_pct = 73 in
let memory_pct = 52 in
let disk_pct = 38 in
let network_pct = 85 in
let battery_pct = 92 in

let cpu_bar = progressbar cpu_pct 100 in
let mem_bar = progressbar memory_pct 100 in
let disk_bar = progressbar disk_pct 100 in
let net_gauge = gauge network_pct 100 in
let bat_gauge = gauge battery_pct 100 in

@dashboard.txt {"
=== System Dashboard ===

CPU: {cpu_bar} {cpu_pct}%
Memory: {mem_bar} {memory_pct}%
Disk: {disk_bar} {disk_pct}%
Network: {net_gauge}
Battery: {bat_gauge}
"}
