// Color blending and gradient generator
// Creates smooth color transitions between colors

let start_color = "#FF0000" in
let end_color = "#0000FF" in

let blend_gradient = \steps
  let step_values = range 0 (1 / steps) 1 in
  map (\t blend_colors start_color end_color t) step_values in

let gradient_5 = blend_gradient 5 in
let gradient_10 = blend_gradient 10 in
let gradient_20 = blend_gradient 20 in

let saturations = [
  {saturation: 0, color: saturate start_color 0},
  {saturation: 0.2, color: saturate start_color 0.2},
  {saturation: 0.4, color: saturate start_color 0.4},
  {saturation: 0.6, color: saturate start_color 0.6},
  {saturation: 0.8, color: saturate start_color 0.8},
  {saturation: 1.0, color: saturate start_color 1.0}
] in

@gradient_analysis.json {
  {
    "blend_from": start_color,
    "blend_to": end_color,
    "gradient_5_steps": gradient_5,
    "gradient_10_steps": gradient_10,
    "gradient_20_steps": gradient_20,
    "saturation_variations": saturations
  }
}
