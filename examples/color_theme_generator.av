# Color theme generator using color functions
# Generates a complete color theme with complementary, analogous, and triadic colors

let base_color = "#2e3440" in
let primary = base_color in
let secondary = complementary primary in
let accent_palette = palette_analogous primary in
let harmony_palette = palette_triadic primary in
let light_theme = palette_monochromatic (lighten primary 0.3) 5 in
let dark_theme = palette_monochromatic (darken primary 0.3) 5 in

@theme.txt {"
COLOR THEME GENERATOR
=====================

Generated Theme: {primary}

Primary Colors:
  Primary: {primary}
  Secondary: {secondary}

Accent Palette (Analogous):
  Colors: {accent_palette}

Harmony Palette (Triadic):
  Colors: {harmony_palette}

Light Theme Palette:
  {light_theme}

Dark Theme Palette:
  {dark_theme}

Accessibility Analysis:
  Primary vs White Contrast: {contrast_ratio primary "#FFFFFF"}
  Secondary vs White Contrast: {contrast_ratio secondary "#FFFFFF"}
"}
