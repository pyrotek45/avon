# System monitor status bar generator
# Generates custom status bar components with formatting and gauges

let cpu_usage = 65 in
let memory_usage = 78 in
let disk_usage = 45 in
let temp_celsius = 62 in

# Format individual status items
let cpu_bar = progressbar cpu_usage 100 in
let mem_bar = progressbar memory_usage 100 in
let disk_bar = progressbar disk_usage 100 in
let temp_str = format_temp temp_celsius in

# Build the status bar by concatenating components
let status_bar_text = 
  "CPU: " + cpu_bar + " | " +
  "MEM: " + mem_bar + " | " +
  "DISK: " + disk_bar + " | " +
  "TEMP: " + temp_str in

@status_bar.txt {"
{status_bar_text}
"}
